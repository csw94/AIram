<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 알림 보여주기 (Android 13+ 는 사용자에게 허락 받아야 함) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 정확한 시각 알람: 알람 시계 앱은 USE_EXACT_ALARM (Android 13+ 설치 시 자동 허용) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 12(API 31~32)용 정확한 알람 권한 -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- 잠금 화면 위에 알람 화면 띄우기 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 재부팅 후 알람 다시 예약 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 알람 소리를 직접 울리는 포그라운드 서비스 (무음 모드에서도 알람 볼륨으로) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".WakeUpHeroApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.WakeUpHero">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 알람 울림 화면: 최근 앱 목록에 남지 않게, 앱의 다른 화면과 따로 -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- 알람 소리·진동 담당 -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 예약한 알람 시각에 깨어나는 리시버 (우리 앱만 보낼 수 있게 exported=false) -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 재부팅·시간 변경·앱 업데이트·권한 변경 시 다음 알람 다시 예약 -->
        <receiver
            android:name=".alarm.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
